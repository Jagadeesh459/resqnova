# ==============================================================================
# ResQNova Environment Variables Template
# Copy this file to .env and configure your secret keys
# ==============================================================================

# Google Gemini API Key (Required for AI Diagnostics and Multi-Modal Triage)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Production Host Port
PORT=3000
NODE_ENV=development
PYTHON_PATH=python

# Supabase Realtime Cloud Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# High-Detail GIS / Topography Tile Service (Thunderforest)
NEXT_PUBLIC_THUNDERFOREST_API_KEY=your-thunderforest-key

# OSRM Routing Engine (Road Geometry & Driving Directions)
NEXT_PUBLIC_OSRM_URL=https://router.project-osrm.org
