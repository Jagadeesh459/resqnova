# ==============================================================================
# ResQNova Environment Variables Template
# Copy this file to .env and configure your secret keys
# ==============================================================================

# Google Gemini API Key (Required for AI Diagnostics and Multi-Modal Triage)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Production Host Port (Render injects this dynamically)
PORT=3000
NODE_ENV=production
PYTHON_PATH=python3

# Optional: Supabase Realtime Cloud Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: High-Detail GIS / Topography Tile Service
NEXT_PUBLIC_THUNDERFOREST_API_KEY=your-thunderforest-key

# Optional: OSRM Routing Engine
NEXT_PUBLIC_OSRM_URL=https://router.project-osrm.org
